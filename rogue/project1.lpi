<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="project1"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="project1.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="unit1.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="Form1"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="Unit1"/>
      </Unit>
      <Unit>
        <Filename Value="obtilemap.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obTileMap"/>
      </Unit>
      <Unit>
        <Filename Value="tptilemap.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="tpTileMap"/>
      </Unit>
      <Unit>
        <Filename Value="cstilemap.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="csTileMap"/>
      </Unit>
      <Unit>
        <Filename Value="obgame.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obGame"/>
      </Unit>
      <Unit>
        <Filename Value="obgameview.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obGameView"/>
      </Unit>
      <Unit>
        <Filename Value="obtilesetindex.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obTilesetIndex"/>
      </Unit>
      <Unit>
        <Filename Value="obplayer.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obPlayer"/>
      </Unit>
      <Unit>
        <Filename Value="tpgame.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="tpGame"/>
      </Unit>
      <Unit>
        <Filename Value="obgamemechanics.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obGameMechanics"/>
      </Unit>
      <Unit>
        <Filename Value="obgameviewsdl2.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obGameViewSDL2"/>
      </Unit>
      <Unit>
        <Filename Value="obcharacterindex.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obCharacterIndex"/>
      </Unit>
      <Unit>
        <Filename Value="obrecordcache.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obRecordCache"/>
      </Unit>
      <Unit>
        <Filename Value="obterrain.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obTerrain"/>
      </Unit>
      <Unit>
        <Filename Value="tpgridarray.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="tpGridArray"/>
      </Unit>
      <Unit>
        <Filename Value="obgamelayer.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obGameLayer"/>
      </Unit>
      <Unit>
        <Filename Value="obcontainers.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="obContainers"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="project1"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="common\sdl\units"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
