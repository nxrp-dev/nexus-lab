dialect "../../../../nexus/projects/nxpackage/language/nxpackage.Language.nxscript";
module NexusPackages "RepositoryIndex.nxscript";

Package Example {
    Id: "NXRP.NexusScript";
    Version: "1.0";
    Author: "Kevin Collins";
    Description: "Illustrative NexusScript package descriptor.";
    License: "MPL-2.0-no-copyleft-exception";
    // SQLite is an illustrative external requirement, not actual package inventory.
    Requires: [@NexusPackages.NexusLib, @NexusPackages.SQLite];
}
