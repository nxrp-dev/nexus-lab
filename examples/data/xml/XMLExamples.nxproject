dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../NexusLab.Environment.nxscript";

Project XMLExamples {
    Id: "NXRP.Examples.XMLExamples";
    Requires: [@Projects.Pthreads, @Projects.X11, @Projects.FCLBase, @Projects.Iconv, @Projects.FCLXML, @Projects.PasJPEG];
    RootDirectory: "../../../../nexus";
    SourceRoot: "../nexus-lab/examples/data/xml";
    OutputRoot: @Tools.OutputRoot + "/XMLExamples/" + @Tools.Native.Name;

    FPC Application {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            @XMLExamples.SourceRoot + "/htmlwithsax.lpr",
            @XMLExamples.SourceRoot + "/reducexml.pas",
            @XMLExamples.SourceRoot + "/testhtml.pas"
        ];
        OutputPath: @XMLExamples.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                @Tools.Native.RTLPath,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/rtl/objpas",
                @XMLExamples.SourceRoot,
                @XMLExamples.OutputRoot
            ];
            IncludePaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64"
            ];
        }
    }
}
