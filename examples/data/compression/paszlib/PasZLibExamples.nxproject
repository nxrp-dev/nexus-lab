dialect "../../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../../../nexus/projects/nxbuild/nxbuild.environment.nxscript";

Project PasZLibExamples {
    Id: "NXRP.Examples.PasZLibExamples";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLExtra, @Projects.FCLXML, @Projects.FCLBase, @Projects.Pthreads];
    RootDirectory: "../../../../../nexus";
    OutputRoot: @Tools.OutputRoot + "/PasZLibExamples/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Tests {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: [
            "../nexus-lab/examples/data/compression/paszlib/example.pas",
            "../nexus-lab/examples/data/compression/paszlib/example2.pas",
            "../nexus-lab/examples/data/compression/paszlib/extractodt.pas",
            "../nexus-lab/examples/data/compression/paszlib/fpunzipper.lpr",
            "../nexus-lab/examples/data/compression/paszlib/fpzipper.lpr",
            "../nexus-lab/examples/data/compression/paszlib/minigzip.pas",
            "../nexus-lab/examples/data/compression/paszlib/miniunz.pas",
            "../nexus-lab/examples/data/compression/paszlib/minizip.pas",
            "../nexus-lab/examples/data/compression/paszlib/testgzstream.pas",
            "../nexus-lab/examples/data/compression/paszlib/testsingle.pas"
        ];
        OutputPath: @PasZLibExamples.OutputRoot;
        RawOptions: ["-Sa", "-Cr", "-Co", "-Ci", "-gl"];
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @PasZLibExamples.OutputRoot
            ];
        }
    }
}
