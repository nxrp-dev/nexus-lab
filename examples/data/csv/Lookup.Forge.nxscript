dialect "../../../../nexus/projects/forge/language/Forge.nxscript";
module "../../../../nexus/projects/csv/config/CSV.nxscript";

// CSV conversion is one command task, not a NexusPackage build.
CSV States (CompileCSV) {
    Source: "data/lookup/STATE.csv";
    SourceTemplate: "../../../../nexus/projects/csv/templates/SQL.mustache";
    Name: STATE_TBL;
    Output: "generated/state.sql";
}
