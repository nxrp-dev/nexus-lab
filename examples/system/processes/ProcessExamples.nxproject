dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../NexusLab.Environment.nxscript";

Project ProcessExamples {
    Id: "NXRP.Examples.ProcessExamples";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLGenerics, @Projects.RTLExtra, @Projects.Pthreads, @Projects.X11, @Projects.FCLBase, @Projects.Iconv, @Projects.FCLProcess, @Projects.PasJPEG];
    RootDirectory: "../../../../nexus";
    SourceRoot: "../nexus-lab/examples/system/processes";
    OutputRoot: @Tools.OutputRoot + "/ProcessExamples/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Application {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: [
            @ProcessExamples.SourceRoot + "/checkipcserver.lpr",
            @ProcessExamples.SourceRoot + "/dbugsrv.pas",
            @ProcessExamples.SourceRoot + "/demohandles.lpr",
            @ProcessExamples.SourceRoot + "/demoproject.pas",
            @ProcessExamples.SourceRoot + "/demoruncommand.pas",
            @ProcessExamples.SourceRoot + "/echoparams.pas",
            @ProcessExamples.SourceRoot + "/empty.pas",
            @ProcessExamples.SourceRoot + "/infinity.pas",
            @ProcessExamples.SourceRoot + "/ipcclient.pas",
            @ProcessExamples.SourceRoot + "/ipcserver.pas",
            @ProcessExamples.SourceRoot + "/simpleipcserver.lpr",
            @ProcessExamples.SourceRoot + "/syncipcclient.pas",
            @ProcessExamples.SourceRoot + "/syncipcserver.pas",
            @ProcessExamples.SourceRoot + "/threadedipc.lpr",
            @ProcessExamples.SourceRoot + "/waitonexit.pas"
        ];
        OutputPath: @ProcessExamples.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @ProcessExamples.SourceRoot,
                @ProcessExamples.OutputRoot
            ];
        }
    }
}
