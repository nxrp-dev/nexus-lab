dialect "Editor.Language.nxscript";

Demo Sample {
  // This comment and surrounding formatting survive unrelated value edits.
  Title: "NexusScript tree editor";
  Enabled: True;
  Count: 3;
  Mode: Light;
  Link: @Sample.Title;
  Items: ["red", "blue"];
  Named: [first: "red", second: "blue"];
  Leaves: [Leaf Inline { Caption: "An inline definition"; }];
  Leaf Child { Caption: "A child definition"; }
}
