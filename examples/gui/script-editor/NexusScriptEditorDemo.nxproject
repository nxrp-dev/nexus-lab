dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module "../../../NexusLab.Environment.nxscript";

Project NexusScriptEditorDemo {
    RootDirectory: "../../..";
    SourceRoot: "examples/gui/script-editor";
    OutputRoot: @Tools.OutputRoot + "/NexusScriptEditorDemo/" + @Tools.Native.Name;

    FPC Application {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            @NexusScriptEditorDemo.SourceRoot + "/NexusScriptEditorDemo.lpr"
        ];
        OutputPath: @NexusScriptEditorDemo.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        RawOptions: ["-gl"];
        Definitions GUI { Defines: [@Lab.Native.GUIDefine]; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.NexusFPC.SourcePath + "/packages/rtl-generics/src",
                "../nexus/packages/nexus-packages/graphics/fcl-image/src",
                "../nexus/packages/nexus-packages/graphics/pasjpeg/src",
                "../nexus/packages/nexus-packages/users/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                "../nexus/packages/nexus-packages/pthreads/src",
                "../nexus/packages/nexus-packages/graphics/x11/src",
                @Tools.Native.RTLPath,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                "packages/nexus-packages/fcl-base/src",
                @Tools.NexusFPC.SourcePath + "/rtl/objpas",
                "../nexus/packages/nexus-packages/iconvenc/src",
                @NexusScriptEditorDemo.SourceRoot,
                @NexusScriptEditorDemo.OutputRoot,
                "../nexus/packages/nexus-packages/gui/src",
                "../nexus/packages/nexus-packages/gui/src/vtv",
                "../nexus/packages/nexus-packages/nxscript/src",
                "../nexus/packages/nexus-packages/serialization/src",
                "../nexus/packages/nexus-packages/serialization/json/src",
                "../nexus/packages/nexus-packages/serialization/fcl-json/src",
                "../nexus/packages/nexus-packages/db/sqlite/src/bindings",
                "../nexus/packages/nexus-packages/network/json-rpc/src",
                "../nexus/packages/nexus-packages/core/src",
                "../nexus/packages/nexus-packages-ext/mustache/external/dmustache",
                "../nexus/packages/nexus-packages-ext/regexpr/external/tregexpr/src",
                "../nexus/packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib",
                "../nexus/packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib/render/software",
                "../nexus/packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/gui",
                "../nexus/packages/nexus-packages/gui/external/fpgui/framework/src/main/resources",
                "../nexus/packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib/" + @Lab.Native.GUIBackend
            ];
            IncludePaths: [
                "../nexus/packages/nexus-packages/pthreads/src",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/inc",
                @Tools.NexusFPC.SourcePath + "/packages/rtl-extra/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/" + @Tools.Native.PascalPlatform,
                @Tools.NexusFPC.SourcePath + "/packages/rtl-objpas/src/x86_64",
                "packages/nexus-packages/fcl-base/src/" + @Tools.Native.PascalPlatform,
                "packages/nexus-packages/fcl-base/src/dummy",
                "../nexus/packages/nexus-packages/graphics/pasjpeg/src",
                "../nexus/packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib",
                "../nexus/packages/nexus-packages/gui/external/fpgui/framework/src/main/resources",
                "../nexus/packages/nexus-packages/gui/external/fpgui/framework/src/main/pascal/corelib/" + @Lab.Native.GUIBackend
            ];
        }
    }
}
