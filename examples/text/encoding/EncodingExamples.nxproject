dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../NexusLab.Environment.nxscript";

Project EncodingExamples {
    Id: "NXRP.Examples.EncodingExamples";
    Requires: [@Projects.NexusRTL, @Projects.Iconv];
    RootDirectory: "../../../../nexus";
    OutputRoot: @Tools.OutputRoot + "/EncodingExamples/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    NXPC Application {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: ["../nexus-lab/examples/text/encoding/iconvtest.pas"];
        OutputPath: @EncodingExamples.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
        }
    }
}
