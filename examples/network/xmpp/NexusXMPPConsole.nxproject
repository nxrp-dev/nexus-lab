dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../NexusLab.Environment.nxscript";

Project NexusXMPPConsole {
    Id: "NXRP.Examples.NexusXMPPConsole";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLExtra, @Projects.Pthreads, @Projects.X11, @Projects.FCLBase, @Projects.Iconv, @Projects.XMPP, @Projects.Synapse, @Projects.OpenSSL, @Projects.FCLXML, @Projects.PasJPEG];
    RootDirectory: "../../../../nexus";
    SourceRoot: "../nexus-lab/examples/network/xmpp";
    OutputRoot: @Tools.OutputRoot + "/NexusXMPPConsole/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    NXPC Application {
        CompilerPath: @Tools.Native.NXPCCompiler;
        SourceFiles: [
            "packages/nexus-packages/network/openssl/src/fpopenssl.pp",
            @NexusXMPPConsole.SourceRoot + "/NexusXMPPConsole.lpr"
        ];
        OutputPath: @NexusXMPPConsole.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @NexusXMPPConsole.SourceRoot,
                @NexusXMPPConsole.OutputRoot
            ];
        }
    }
}
