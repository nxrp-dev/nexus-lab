dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../../nexus/projects/nxbuild/nxbuild.environment.nxscript";

Project NexusSynapseExamples {
    Id: "NXRP.Examples.NexusSynapseExamples";
    Requires: [@Projects.NexusRTL, @Projects.RTLObjPas, @Projects.RTLExtra, @Projects.OpenSSL, @Projects.Synapse, @Projects.NexusTest, @Projects.FCLBase, @Projects.Pthreads];
    RootDirectory: "../../../../nexus";
    OutputRoot: @Tools.OutputRoot + "/NexusSynapseExamples/" + @Tools.Native.Name + "/" + $BuildConfiguration;
    FPC Tests {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            "packages/nexus-packages/network/openssl/src/fpopenssl.pp",
            "../nexus-lab/examples/network/sockets/isockcli.pas",
            "../nexus-lab/examples/network/sockets/isocksvr.pas",
            "../nexus-lab/examples/network/sockets/testdns.pas",
            "../nexus-lab/examples/network/sockets/testverify.pas"
        ];
        OutputPath: @NexusSynapseExamples.OutputRoot;
        RawOptions: ["-Cr", "-Co", "-Ci", "-gl"];
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @NexusSynapseExamples.OutputRoot,
                "packages/nexus-packages/network/openssl/test"
            ];
        }
    }
}
