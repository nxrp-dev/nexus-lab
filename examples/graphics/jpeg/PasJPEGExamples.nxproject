// Build the portable JPEG command-line demonstrations.
dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../NexusLab.Environment.nxscript";
Project PasJPEGExamples {
    Id: "NXRP.Examples.PasJPEGExamples";
    Requires: [@Projects.PasJPEG];
    RootDirectory: "../../../../nexus";
    SourceRoot: "../nexus-lab/examples/graphics/jpeg";
    OutputRoot: @Tools.OutputRoot + "/PasJPEGExamples/" + @Tools.Native.Name;
    FPC Applications {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [
            @PasJPEGExamples.SourceRoot + "/cjpeg.pas",
            @PasJPEGExamples.SourceRoot + "/djpeg.pas",
            @PasJPEGExamples.SourceRoot + "/jpegtran.pas",
            @PasJPEGExamples.SourceRoot + "/demo.pas",
            @PasJPEGExamples.SourceRoot + "/rdjpgcom.pas"
        ];
        OutputPath: @PasJPEGExamples.OutputRoot;
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: Delphi; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Tools.Native.RTLPath,
                @PasJPEGExamples.SourceRoot
            ];
            IncludePaths: [];
        }
    }
}
