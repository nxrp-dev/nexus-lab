dialect "../../../../nexus/projects/forge/language/Forge.nxscript";

// The repository's output directory must exist. No upstream files are replaced.
// SDK/CRT paths are explicit: no Visual Studio shell initialization is required.
Project AbbreviaLLVM {
    Id: "NXRP.Abbrevia.NativeRoundTrip";
    Outputs: [Binary: "../../../../nexus/output/AbbreviaLLVM-roundtrip.exe"];
    Clang BlockSort {
        Template: "../../../../nexus/projects/forge/templates/Clang.mustache";
        Executable: "C:/Program Files/LLVM/bin/clang.exe";
        WorkingDirectory: "../../../../nexus";
        Source: ["../../../../nexus/packages/nexus-packages-ext/compression/abbrevia/external/abbrevia/thirdparty/bzip2/blocksort.c"];
        Output: "output/AbbreviaLLVM-blocksort.obj";
        CompileOnly: True; Target: "x86_64-pc-windows-msvc"; Standard: "c11";
        IncludePaths: [
            "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133/include",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/ucrt",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/shared",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/um"
        ];
        Defines: ["WIN32", "_FILE_OFFSET_BITS=64", "BZ_NO_STDIO"];
        Arguments: ["-O2", "-fno-stack-protector"];
    }
    Clang BzLib {
        Template: "../../../../nexus/projects/forge/templates/Clang.mustache";
        Executable: "C:/Program Files/LLVM/bin/clang.exe";
        WorkingDirectory: "../../../../nexus";
        Source: ["../../../../nexus/packages/nexus-packages-ext/compression/abbrevia/external/abbrevia/thirdparty/bzip2/bzlib.c"];
        Output: "output/AbbreviaLLVM-bzlib.obj";
        CompileOnly: True; Target: "x86_64-pc-windows-msvc"; Standard: "c11";
        IncludePaths: [
            "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133/include",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/ucrt",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/shared",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/um"
        ];
        Defines: ["WIN32", "_FILE_OFFSET_BITS=64", "BZ_NO_STDIO"];
        Arguments: ["-O2", "-fno-stack-protector"];
    }
    Clang Compress {
        Template: "../../../../nexus/projects/forge/templates/Clang.mustache";
        Executable: "C:/Program Files/LLVM/bin/clang.exe";
        WorkingDirectory: "../../../../nexus";
        Source: ["../../../../nexus/packages/nexus-packages-ext/compression/abbrevia/external/abbrevia/thirdparty/bzip2/compress.c"];
        Output: "output/AbbreviaLLVM-compress.obj";
        CompileOnly: True; Target: "x86_64-pc-windows-msvc"; Standard: "c11";
        IncludePaths: [
            "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133/include",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/ucrt",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/shared",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/um"
        ];
        Defines: ["WIN32", "_FILE_OFFSET_BITS=64", "BZ_NO_STDIO"];
        Arguments: ["-O2", "-fno-stack-protector"];
    }
    Clang CrcTable {
        Template: "../../../../nexus/projects/forge/templates/Clang.mustache";
        Executable: "C:/Program Files/LLVM/bin/clang.exe";
        WorkingDirectory: "../../../../nexus";
        Source: ["../../../../nexus/packages/nexus-packages-ext/compression/abbrevia/external/abbrevia/thirdparty/bzip2/crctable.c"];
        Output: "output/AbbreviaLLVM-crctable.obj";
        CompileOnly: True; Target: "x86_64-pc-windows-msvc"; Standard: "c11";
        IncludePaths: [
            "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133/include",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/ucrt",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/shared",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/um"
        ];
        Defines: ["WIN32", "_FILE_OFFSET_BITS=64", "BZ_NO_STDIO"];
        Arguments: ["-O2", "-fno-stack-protector"];
    }
    Clang Decompress {
        Template: "../../../../nexus/projects/forge/templates/Clang.mustache";
        Executable: "C:/Program Files/LLVM/bin/clang.exe";
        WorkingDirectory: "../../../../nexus";
        Source: ["../../../../nexus/packages/nexus-packages-ext/compression/abbrevia/external/abbrevia/thirdparty/bzip2/decompress.c"];
        Output: "output/AbbreviaLLVM-decompress.obj";
        CompileOnly: True; Target: "x86_64-pc-windows-msvc"; Standard: "c11";
        IncludePaths: [
            "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133/include",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/ucrt",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/shared",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/um"
        ];
        Defines: ["WIN32", "_FILE_OFFSET_BITS=64", "BZ_NO_STDIO"];
        Arguments: ["-O2", "-fno-stack-protector"];
    }
    Clang Huffman {
        Template: "../../../../nexus/projects/forge/templates/Clang.mustache";
        Executable: "C:/Program Files/LLVM/bin/clang.exe";
        WorkingDirectory: "../../../../nexus";
        Source: ["../../../../nexus/packages/nexus-packages-ext/compression/abbrevia/external/abbrevia/thirdparty/bzip2/huffman.c"];
        Output: "output/AbbreviaLLVM-huffman.obj";
        CompileOnly: True; Target: "x86_64-pc-windows-msvc"; Standard: "c11";
        IncludePaths: [
            "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133/include",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/ucrt",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/shared",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/um"
        ];
        Defines: ["WIN32", "_FILE_OFFSET_BITS=64", "BZ_NO_STDIO"];
        Arguments: ["-O2", "-fno-stack-protector"];
    }
    Clang RandTable {
        Template: "../../../../nexus/projects/forge/templates/Clang.mustache";
        Executable: "C:/Program Files/LLVM/bin/clang.exe";
        WorkingDirectory: "../../../../nexus";
        Source: ["../../../../nexus/packages/nexus-packages-ext/compression/abbrevia/external/abbrevia/thirdparty/bzip2/randtable.c"];
        Output: "output/AbbreviaLLVM-randtable.obj";
        CompileOnly: True; Target: "x86_64-pc-windows-msvc"; Standard: "c11";
        IncludePaths: [
            "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133/include",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/ucrt",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/shared",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/um"
        ];
        Defines: ["WIN32", "_FILE_OFFSET_BITS=64", "BZ_NO_STDIO"];
        Arguments: ["-O2", "-fno-stack-protector"];
    }
    LLVMAr Bzip2Library {
        Template: "../../../../nexus/projects/forge/templates/LLVMAr.mustache";
        Executable: "C:/Program Files/LLVM/bin/llvm-ar.exe";
        WorkingDirectory: "../../../../nexus";
        Operation: "rcs"; Arguments: ["--format=coff"];
        Output: "output/AbbreviaLLVM-bzip2.lib";
        Objects: [
            "output/AbbreviaLLVM-blocksort.obj", "output/AbbreviaLLVM-bzlib.obj",
            "output/AbbreviaLLVM-compress.obj", "output/AbbreviaLLVM-crctable.obj",
            "output/AbbreviaLLVM-decompress.obj", "output/AbbreviaLLVM-huffman.obj",
            "output/AbbreviaLLVM-randtable.obj"
        ];
    }
    Clang RoundTrip {
        Template: "../../../../nexus/projects/forge/templates/Clang.mustache";
        Executable: "C:/Program Files/LLVM/bin/clang++.exe";
        WorkingDirectory: "../../../../nexus";
        Source: ["../../../../nexus/projects/forge/test/fixtures/llvm/AbbreviaRoundTrip.cpp"];
        Output: "output/AbbreviaLLVM-roundtrip.exe";
        CompileOnly: False; Target: "x86_64-pc-windows-msvc"; Standard: "c++17";
        IncludePaths: [
            "packages/nexus-packages-ext/compression/abbrevia/external/abbrevia/thirdparty/bzip2",
            "C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133/include",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/ucrt",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/shared",
            "C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/um"
        ];
        Arguments: [
            "-O2", "-fuse-ld=lld", "output/AbbreviaLLVM-bzip2.lib",
            "-Xlinker", "/libpath:C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.29.30133/lib/x64",
            "-Xlinker", "/libpath:C:/Program Files (x86)/Windows Kits/10/Lib/10.0.19041.0/ucrt/x64",
            "-Xlinker", "/libpath:C:/Program Files (x86)/Windows Kits/10/Lib/10.0.19041.0/um/x64"
        ];
    }
    Run VerifyRoundTrip {
        Template: "../../../../nexus/projects/forge/templates/Run.mustache";
        Executable: @AbbreviaLLVM.Outputs.Binary;
    }
}
