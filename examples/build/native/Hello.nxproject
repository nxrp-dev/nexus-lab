dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module Projects "../../../../nexus/projects/nxbuild/Projects.nxscript";
module "../../../NexusLab.Environment.nxscript";

Project Hello {
    Id: "NXRP.Examples.Hello";
    Requires: [@Projects.NexusRTL, @Projects.RTLSystem, @Projects.RTLObjPas, @Projects.RTLExtra, @Projects.Pthreads, @Projects.X11, @Projects.FCLBase, @Projects.Iconv, @Projects.PasJPEG];
    RootDirectory: "../../../../nexus";
    SourceRoot: "../nexus-lab/examples/build/native";
    OutputRoot: @Tools.OutputRoot + "/Hello/" + @Tools.Native.Name + "/" + $BuildConfiguration;

    FPC Application {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [@Hello.SourceRoot + "/Hello.lpr"];
        OutputPath: @Hello.OutputRoot;
        Target Platform { OperatingSystem: @Tools.Native.OS; }
        Config Options { DisableDefaultConfigFiles: True; }
        Language Pascal { Mode: ObjFPC; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [
                @Hello.SourceRoot,
                @Hello.OutputRoot
            ];
        }
    }
}
