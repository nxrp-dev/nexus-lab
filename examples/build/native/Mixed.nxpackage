dialect "../../../../nexus/projects/nxbuild/language/nxbuild.Language.nxscript";
module "../../../NexusLab.Environment.nxscript";

Package Mixed {
    RootDirectory: "../../..";
    SourceRoot: "examples/build/native";
    OutputRoot: "output/Mixed/" + @Tools.Native.Name;
    LLVM Native {
        CompilerPath: @Tools.Native.LLVMCompiler;
        BuildKind: Object;
        Target: @Tools.Native.Triple;
        SourceFiles: [@Mixed.SourceRoot + "/native.c", @Mixed.SourceRoot + "/twice.cpp"];
        OutputPath: @Mixed.OutputRoot + "/native";
    }
    FPC Applications {
        CompilerPath: @Tools.Native.FPCCompiler;
        SourceFiles: [@Mixed.SourceRoot + "/Mixed.lpr", @Mixed.SourceRoot + "/Hello.lpr"];
        OutputPath: @Mixed.OutputRoot + "/application";
        Config Options { DisableDefaultConfigFiles: True; }
        Assembler Native TargetOS[linux] { OutputFormat: "as-clang"; }
        Files Paths {
            CompilerUtilitiesPath: @Tools.Native.CompilerUtilitiesPath;
            UnitPaths: [@Tools.Native.RTLPath];
            ObjectPaths: [@Mixed.Native.OutputPath];
        }
    }
}
