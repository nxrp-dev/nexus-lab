dialect "../nexus/projects/forge/language/Forge.nxscript";
Group Examples {
    NXBuild Hello {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/build/native/Hello.nxproject";
    }
    NXBuild Mixed {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/build/native/Mixed.nxpackage";
    }
    NXBuild JSON {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/data/json/JSONExamples.nxproject";
    }
    NXBuild XML {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/data/xml/XMLExamples.nxproject";
    }
    NXBuild Database {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/data/database/DatabaseExamples.nxproject";
    }
    NXBuild Processes {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/system/processes/ProcessExamples.nxproject";
    }
    NXBuild Registry {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/system/registry/RegistryExamples.nxproject";
    }
    NXBuild Images {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/graphics/images/FCLImageExamples.nxproject";
    }
    NXBuild ScriptEditor {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/gui/script-editor/NexusScriptEditorDemo.nxproject";
    }
    NXBuild VirtualTree {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/gui/virtual-tree/NexusVirtualTreeViewDemo.nxproject";
    }
    NXBuild XMPP {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/network/xmpp/NexusXMPPConsole.nxproject";
    }
    NXBuild TLS {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/network/tls/test1.nxproject";
    }
    NXBuild KeyPair {
        Template: "../nexus/projects/forge/templates/NXBuild.mustache";
        EntryPoint: "examples/network/tls/genkeypair.nxproject";
    }
}
